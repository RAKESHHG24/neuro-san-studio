{
    include "/workspaces/neuro-san-studio/registries/aaosa.hocon"
    include "/workspaces/neuro-san-studio/config/llm_config.hocon"
    "metadata": {
        "description": "Databricks Metadata Assistant",
        "tags": [
            "Databricks",
            "Unity Catalog",
            "Metadata",
            "Data Engineering"
        ],
        "sample_queries": [
            "List all catalogs",
            "Show schemas in main catalog",
            "List tables in main default schema",
            "Show columns in customer table",
            "Describe customer_master table",
            "Show 5 rows from test123.filestore.customers_bronze"
        ]
    },

    include "/workspaces/neuro-san-studio/config/llm_config.hocon",

    "instructions_prefix": """
    You are a Databricks Metadata Assistant.

    Help users with Databricks metadata and SQL results.

    Metadata discovery:
    - Catalogs
    - Schemas
    - Tables
    - Columns

    Query execution:
    - Build SQL for data-preview and analytic questions.
    - Use QueryExecutorAPI for SQL execution.

    Rules:
    - Always use tools; do not answer from memory.
    - Never invent metadata or query results.
    - If the user asks for records/rows/sample/top/preview, execute SQL and return rows.
    - Use metadata tools only when they are needed to answer a metadata request or to disambiguate missing names.
    """

    "tools": [

        {
            "name": "Databricks_Metadata_Agent",

            "function": {
                "description": """
                Top level Databricks metadata assistant.
                """
                "parameters": {
                    "type": "object",
                    "properties": {
                        "query": {
                            "type": "string",
                            "description": "User metadata request"
                        }
                    },
                    "required": ["query"]
                }
            },

            "instructions": ${instructions_prefix} """
            Route requests as follows:

            Catalog questions -> Catalog_Agent
            Schema questions -> Schema_Agent
            Table questions -> Table_Agent
            Column questions -> Column_Agent
            Data preview / SQL / analytics questions -> QueryExecutorAPI

            For requests like "show sample rows", "top N rows", "select ... from ...", or "count from table":
            - Build a valid Databricks SQL query.
            - Prefer fully-qualified names catalog.schema.table when provided.
            - Apply LIMIT when user asks for samples.
            - Call QueryExecutorAPI with sql_query only.
            - Do not call Catalog_Agent first unless catalog/schema/table values are missing.

            Combine responses into a natural language answer.
            """ ${aaosa_instructions},

            "tools": [
                "Catalog_Agent",
                "Schema_Agent",
                "Table_Agent",
                "Column_Agent",
                "QueryExecutorAPI",
                "ExportResultsAPI"
            ]
        },

        {
            "name": "Catalog_Agent",

            "function": ${aaosa_call}{
                "description": """
                Handles catalog discovery.
                """
            },

            "instructions": """
            Return available catalogs and descriptions.
            """ ${aaosa_instructions},

            "tools": [
                "CatalogDiscoveryAPI"
            ]
        },

        {
            "name": "Schema_Agent",

            "function": ${aaosa_call}{
                "description": """
                Handles schema discovery.
                """
            },

            "instructions": """
            Return schemas for a given catalog.
            """ ${aaosa_instructions},

            "tools": [
                "SchemaDiscoveryAPI"
            ]
        },

        {
            "name": "Table_Agent",

            "function": ${aaosa_call}{
                "description": """
                Handles table discovery.
                """
            },

            "instructions": """
            Return tables and views for a schema.
            """ ${aaosa_instructions},

            "tools": [
                "TableDiscoveryAPI"
            ]
        },

        {
            "name": "Column_Agent",

            "function": ${aaosa_call}{
                "description": """
                Handles column discovery.
                """
            },

            "instructions": """
            Return column names, types and comments.
            """ ${aaosa_instructions},

            "tools": [
                "ColumnDiscoveryAPI"
            ]
        },

        {
            "name": "CatalogDiscoveryAPI",

            "function": {
                "description": "Returns Databricks catalogs"
                
            },

            "class": "coded_tools.basic.databricks_metadata_assistant.catalog_discovery_tool.CatalogDiscoveryTool"
        },

        {
            "name": "SchemaDiscoveryAPI",

            "function": {
                "description": "Returns schemas for a catalog"

                "parameters": {
                    "type": "object",
                    "properties": {
                        "catalog": {
                            "type": "string",
                            "description": "Databricks catalog name"
                        }
                    },
                    "required": [
                        "catalog"
                    ]
                }
            },

            "class": "coded_tools.basic.databricks_metadata_assistant.schema_discovery.SchemaDiscoveryTool"
        },

        {
            "name": "TableDiscoveryAPI",

            "function": {
                "description": "Returns tables for a schema"

                "parameters": {
                    "type": "object",
                    "properties": {
                        "catalog": {
                            "type": "string"
                        },
                        "schema_name": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "catalog",
                        "schema_name"
                    ]
                }
            },

            "class": "coded_tools.basic.databricks_metadata_assistant.table_discovery.TableDiscoveryTool"
        },

        {
            "name": "ColumnDiscoveryAPI",

            "function": {
                "description": "Returns table column metadata"

                "parameters": {
                    "type": "object",
                    "properties": {
                        "catalog": {
                            "type": "string"
                        },
                        "schema_name": {
                            "type": "string"
                        },
                        "table": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "catalog",
                        "schema_name",
                        "table"
                    ]
                }
            },

            "class": "coded_tools.basic.databricks_metadata_assistant.column_discovery.ColumnDiscoveryTool"
        },

        {
            "name": "QueryExecutorAPI",

            "function": {
                "description": "Executes a SQL query against Databricks and returns the resulting rows"

                "parameters": {
                    "type": "object",
                    "properties": {
                        "sql_query": {
                            "type": "string",
                            "description": "The SQL query to execute"
                        }
                    },
                    "required": [
                        "sql_query"
                    ]
                }
            },

            "class": "coded_tools.basic.databricks_metadata_assistant.query_executor.QueryExecutorTool"
        },

        {
            "name": "ExportResultsAPI",

            "function": {
                "description": "Executes a SQL query and saves the results to a CSV or Excel file"

                "parameters": {
                    "type": "object",
                    "properties": {
                        "sql_query": {
                            "type": "string",
                            "description": "The SQL query to execute"
                        },
                        "output_format": {
                            "type": "string",
                            "description": "The export format: csv or excel"
                        },
                        "file_name": {
                            "type": "string",
                            "description": "Suggested output file name without extension"
                        }
                    },
                    "required": [
                        "sql_query"
                    ]
                }
            },

            "class": "coded_tools.basic.databricks_metadata_assistant.export_results.ExportResultsTool"
        }
    ]
}